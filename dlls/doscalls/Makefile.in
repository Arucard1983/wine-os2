MODULE    = doscalls.dll
IMPORTLIB = doscalls

# Link against the native Wine/NT low-level kernel services
IMPORTS   = ntdll

ENABLE_ARCHS = i386

C_SRCS = \
	doscalls_file.c \
	doscalls_mem.c \
	doscalls_proc.c \
	doscalls_system.c \
	doscalls_main.c

SOURCES = \
	doscalls_file.c \
	doscalls_mem.c \
	doscalls_proc.c \
	doscalls_system.c \
	doscalls_main.c
